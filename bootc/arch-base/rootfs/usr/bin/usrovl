#!/usr/bin/bash
#
# usrovl — run a command with a writable overlay on /usr
#
# Maintains overlay upper and work directories under
#   /var/usr-overlays/<overlay_name>/{upper,work}
# and runs the specified command via bubblewrap with a writable /usr.
#
# Usage: usrovl [--pidfile PATH] <overlay_name> [command...]
#   If no command is given, /bin/bash is run.

set -euo pipefail

# ---------- Root check ----------
if [[ "$(id -u)" -ne 0 ]]; then
    echo "Error: usrovl must be run as root (UID 0)" >&2
    exit 1
fi

# ---------- Option parsing ----------
pidfile=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pidfile)
            pidfile="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: usrovl [--pidfile PATH] <overlay_name> [command...]" >&2
            echo "  If no command is given, /bin/bash is run." >&2
            exit 0
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# ---------- Argument parsing ----------
if [[ $# -lt 1 ]]; then
    echo "Usage: usrovl [--pidfile PATH] <overlay_name> [command...]" >&2
    echo "  If no command is given, /bin/bash is run." >&2
    exit 1
fi

overlay_name="$1"
shift

# ---------- Default command ----------
if [[ $# -eq 0 ]]; then
    set -- /bin/bash
fi

# ---------- Overlay directory setup ----------
overlay_base="/var/usr-overlays/${overlay_name}"
upper_dir="${overlay_base}/upper"
work_dir="${overlay_base}/work"

if [[ ! -d "$upper_dir" ]]; then
    mkdir -p "$upper_dir"
fi

if [[ ! -d "$work_dir" ]]; then
    mkdir -p "$work_dir"
fi

# ---------- Write PID file if requested ----------
if [[ -n "$pidfile" ]]; then
    # Ensure parent directory exists
    mkdir -p "$(dirname "$pidfile")"
    # Write our PID before exec — after exec this PID becomes bwrap's PID,
    # which is the namespace holder. This is the correct PID to use with
    # nsenter --target to join the mount namespace.
    echo "$$" > "$pidfile"
fi

# ---------- Execute via bubblewrap ----------
exec bwrap \
    --dev-bind / / \
    --overlay-src /usr \
    --overlay "$upper_dir" "$work_dir" /usr \
    -- "$@"