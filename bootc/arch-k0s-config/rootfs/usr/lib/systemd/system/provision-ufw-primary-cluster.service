[Unit]
Description=Provision UFW firewall for primary cluster connections
ConditionPathExists=!/var/lib/provisions/ufw-primary-cluster
Requires=ufw.service
After=provision-pre.target
After=ufw.service provision-ufw.service

[Service]
StateDirectory=provisions
Type=oneshot
# Accept traffic from client IP block (192.168.192.0/23)
# Accept intra-cluster traffic (192.168.194.0/23)
# Accept access to kube api from kube-bridge network pods
ExecStart=/usr/bin/flock /run/provision-ufw.lock /bin/bash -c ' \
            /usr/bin/ufw allow in on zt3uq46eqh from 192.168.192.0/23 && \
            /usr/bin/ufw allow in on zt3uq46eqh from 192.168.194.0/23 && \
            /usr/bin/ufw allow in on kube-bridge && \
            /usr/bin/ufw allow in on veth+ && \
            /usr/bin/ufw route allow in on kube-bridge out on kube-bridge'
ExecStart=/usr/bin/touch ${STATE_DIRECTORY}/ufw-primary-cluster
RemainAfterExit=yes