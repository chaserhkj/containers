# Build custom-versioned pytorch wheels using ROCm from TheRock
# Converted from https://github.com/ROCm/TheRock/blob/main/.github/workflows/build_portable_linux_pytorch_wheels.yml
FROM ghcr.io/rocm/therock_build_manylinux_x86_64@sha256:6e8242d347af7e0c43c82d5031a3ac67b669f24898ea8dc2f1d5b7e4798b66bd as base
FROM base as src
ARG PYTORCH_GIT_REF=release/2.9

RUN git clone https://github.com/ROCm/TheRock /work

WORKDIR /work

ENV GITHUB_ENV=/github.env

ENV GITHUB_PATH=/github.path

COPY github_sim.sh /

RUN . /github_sim.sh && \
    git config --global user.name "therockbot" && git config --global user.email "therockbot@amd.com"

RUN . /github_sim.sh && \
    ./external-builds/pytorch/pytorch_torch_repo.py checkout \
        --gitrepo-origin https://github.com/ROCm/pytorch.git \
        --repo-hashtag ${PYTORCH_GIT_REF} --depth 1

RUN . /github_sim.sh && \
    ./external-builds/pytorch/pytorch_audio_repo.py checkout \
        --require-related-commit --depth 1

RUN . /github_sim.sh && \
    ./external-builds/pytorch/pytorch_vision_repo.py checkout \
        --require-related-commit --depth 1

RUN . /github_sim.sh && \
    ./external-builds/pytorch/pytorch_triton_repo.py checkout \
        --depth 1

FROM src as build

ARG PYTHON_VERSION=3.10
ARG ROCM_VERSION=7.11.0a20260118
ARG AMDGPU_FAMILY=gfx1151
ARG INDEX_URL=https://rocm.nightlies.amd.com/v2

RUN . /github_sim.sh && \
    python build_tools/github_actions/python_to_cp_version.py --python-version ${PYTHON_VERSION}

RUN . /github_sim.sh && python_dir="/opt/python/$GITHUB_ENV_cp_version" && \
    [ -x "$python_dir/bin/python" ] || exit 1 && \
    echo "$python_dir/bin" >> $GITHUB_PATH

RUN . /github_sim.sh && \
    mkdir -p /dist && \
    mkdir -p /tmp/pipcache && \
    pip install packaging && \
    python build_tools/github_actions/determine_version.py --rocm-version ${ROCM_VERSION}

RUN . /github_sim.sh && \
    ./external-builds/pytorch/build_prod_wheels.py \
        build \
        --install-rocm \
        --pip-cache-dir /tmp/pipcache \
        --index-url "${INDEX_URL}/${AMDGPU_FAMILY}/" \
        --clean \
        --output-dir /dist $GITHUB_ENV_optional_build_prod_arguments
    python ./build_tools/github_actions/write_torch_versions.py --dist-dir /dist

RUN . /github_sim.sh && \
    python external-builds/pytorch/sanity_check_wheel.py /dist

FROM scratch

COPY --from=build /dist /
