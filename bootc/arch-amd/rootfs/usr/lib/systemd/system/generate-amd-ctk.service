[Unit]
Description=Generate AMD container device interface (CDI) spec
RequiresMountsFor=/etc
ConditionPathIsReadWrite=/etc
After=sys-module-amdgpu.device

[Service]
Type=oneshot
ExecCondition=/bin/bash -c '/usr/bin/amd-ctk cdi validate | /bin/grep "CDI spec is invalid"'
ExecStart=/usr/bin/amd-ctk cdi generate
