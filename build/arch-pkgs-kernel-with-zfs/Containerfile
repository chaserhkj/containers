FROM arch-aur-builder as builder

RUN --mount=type=cache,target=/var/lib/pacman/sync,id=pacman-sync \
    --mount=type=cache,target=/var/cache/pacman/pkg,id=pacman-cache \
    pacman -Sy --needed --noconfirm jq

RUN sudo bash <<'EOF'
set -euo pipefail

KERNEL_VERSION=$(curl -L 'https://aur.archlinux.org/rpc/v5/info?arg[]=zfs-linux' | jq -r '.results.[]|select(.Name == "zfs-linux")|.Depends.[]|select(startswith("linux="))'| cut -f2 -d=)

mkdir -p /pkgs
cd /tmp

curl -fLO "https://archive.archlinux.org/packages/l/linux/linux-${KERNEL_VERSION}-x86_64.pkg.tar.zst"
curl -fLO "https://archive.archlinux.org/packages/l/linux-headers/linux-headers-${KERNEL_VERSION}-x86_64.pkg.tar.zst"

pacman -U --noconfirm linux-${KERNEL_VERSION}-x86_64.pkg.tar.zst linux-headers-${KERNEL_VERSION}-x86_64.pkg.tar.zst

cp -v linux-${KERNEL_VERSION}-x86_64.pkg.tar.zst /pkgs/
cp -v linux-headers-${KERNEL_VERSION}-x86_64.pkg.tar.zst /pkgs/
EOF

RUN gpg --keyserver keyserver.ubuntu.com --recv-keys 6AD860EED4598027 && \
    aur sync -n --noview zfs-linux zfs-utils

RUN sudo bash <<'EOF'
cd /var/build/repo

pkg=$(ls| grep -E '^zfs-linux-[0-9\.-_]+(arch[0-9]+)?[\.0-9-]+x86_64\.pkg\.tar\.zst$'|sort|tail -n1)
cp -v $pkg /pkgs

pkg=$(ls| grep -E '^zfs-utils-[0-9\.-]+x86_64\.pkg\.tar\.zst$'|sort|tail -n1)
cp -v $pkg /pkgs
EOF

FROM scratch as arch-pkgs-base
COPY --from=builder /pkgs/*.pkg.tar.* /