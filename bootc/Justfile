mod arch-config 'arch-host-config/'

export CTR_BUILD_CONTEXT_FROM_BOOTC_ARCH_BASE := "bootc-arch"
export CTR_BUILD_CONTEXT_IMG_BOOTC_ARCH_BASE := env(
    "CTR_BASE_ARCH_BOOTC",
    "ghcr.io/bootcrew/arch-bootc:latest"
    )

default:
    just build-image arch-k0s
    just build-image arch-k0s-config
    just build-image arch-common-config
    just build-image arch-common-home-config
    just build-variant-image arch-common-config arch-k0s-config
    just build-variant-image arch-common-home-config arch-k0s-config-common-config
    just build-variant-image arch-amd arch-k0s-config-common-config-common-home-config

build-all:
    just build-base-images
    just default

build-base-images:
    just build-image arch-base
    just build-live-images arch

build-live-images distro:
    ${buildImageScript} {{distro}}-live --target builder -t bootc-{{distro}}-live-builder
    ${buildImageScript} {{distro}}-live -t bootc-{{distro}}-live

build-image subdir:
    ${buildImageScript} {{subdir}} -t bootc-{{subdir}}

build-variant-image subdir new_base:
    #!/usr/bin/env bash
    set -e
    postfix=$(echo "{{subdir}}" | sed "s/[^-]*-//")

    echo "Use base {{new_base}} for bootc-{{new_base}}-$postfix"

    export CTR_BUILD_CONTEXT_FROM_VARIANT_BASE=base
    export CTR_BUILD_CONTEXT_IMG_VARIANT_BASE=bootc-{{new_base}}

    ${buildImageScript} {{subdir}} -t bootc-{{new_base}}-$postfix